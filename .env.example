# ──────────────────────────────────────────────────────────────────────────
# Audit Status Portal — environment variables
# Copy to `.env.local` for local development. On Vercel, set these in the
# Project Settings → Environment Variables (KV_* are auto-injected by the
# Vercel KV / Upstash integration).
# ──────────────────────────────────────────────────────────────────────────

# ── Public (exposed to the browser) ──────────────────────────────────────
# Human-readable dataset label and publication date shown in the UI footer.
NEXT_PUBLIC_DATASET_LABEL="AUDIT_SELECTION_V3 (sample)"
NEXT_PUBLIC_DATASET_DATE="2024-06-29"
# Canonical site origin (used for absolute SEO/OpenGraph URLs).
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# ── Vercel KV / Upstash (rate limits, counters, admin audit log) ─────────
# Auto-injected by the Vercel KV integration in production. If unset locally,
# the app falls back to an in-memory limiter (per-instance, dev only).
KV_REST_API_URL=""
KV_REST_API_TOKEN=""
# Optional read-only token (not required by this app).
KV_REST_API_READ_ONLY_TOKEN=""

# ── Rate-limit knobs (optional; sensible defaults apply) ──────────────────
RATE_LIMIT_PER_MINUTE="10"
RATE_LIMIT_PER_DAY="100"

# ── Admin console (Auth.js v5) ───────────────────────────────────────────
# Generate with: npx auth secret   (or: openssl rand -base64 32)
AUTH_SECRET=""
# Comma-separated list of email addresses allowed into /admin.
ADMIN_EMAIL_ALLOWLIST="admin@example.gov.bd"
# Shared password for the credentials-based admin login (demo gate).
# In production prefer an OAuth provider or Vercel Password Protection.
ADMIN_PASSWORD=""

# ── Optional: Sentry ──────────────────────────────────────────────────────
# SENTRY_DSN=""
# NEXT_PUBLIC_SENTRY_DSN=""
